# ──────────────────────────────────────────────────────────────
# TechTaru DocIQ — Environment Variables
# ──────────────────────────────────────────────────────────────
# 1. Copy this file:   cp .env.example .env
# 2. Paste your real OpenAI API key below (get one at platform.openai.com)
#    With a key configured the app uses OpenAI Structured Outputs.
#    With the key LEFT EMPTY the app runs the built-in deterministic
#    heuristic engine — every feature still works in demo mode.
# 3. Never commit .env to git!

# ── Required for AI extraction ──────────────────────────────────
OPENAI_API_KEY=

# ── Optional overrides (defaults shown) ────────────────────────
OPENAI_MODEL=gpt-4o-mini
MAX_TOKENS=4096
DEBUG=false
MAX_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=20
MAX_RETRIES=3
DATABASE_URL=sqlite+aiosqlite:///./extraction_history.db
